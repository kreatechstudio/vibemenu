# Copiar a .env.local (que esta en .gitignore via *.local)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# El service_role_key NUNCA va aqui. Vive solo como secreto de la Edge Function
# `stripe-webhook` en el dashboard de Supabase.

# Site key del widget de Cloudflare Turnstile (publica). Si se deja vacia, los
# formularios de auth funcionan igual sin captcha. La secret key NO va aqui:
# se pega directo en Supabase Dashboard > Authentication > Attack Protection.
VITE_TURNSTILE_SITE_KEY=
